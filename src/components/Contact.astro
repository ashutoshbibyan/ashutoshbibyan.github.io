<main class="max-w-7xl mx-auto px-6 py-20 min-h-screen">
      <div class="mb-16 text-center md:text-left">
        <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-4">Let’s work together</h1>
        <p class="text-slate-500 font-mono text-sm uppercase tracking-widest">Available for new opportunities & collaborations</p>
      </div>

      <div class="grid grid-cols-12 gap-6">
        
        <div class="col-span-12 lg:col-span-4 space-y-6">
          <div class="bg-slate-900 rounded-3xl p-8 text-white shadow-xl">
            <h3 class="text-xl font-bold mb-6 text-sky-400">Contact Info</h3>
            
            <div class="space-y-6">
              <a href="mailto:ashutosh2013official@gmail.com" class="flex items-center gap-4 group">
                <div class="w-12 h-12 bg-slate-800 rounded-2xl flex items-center justify-center group-hover:bg-sky-500 transition-colors">
                  📧
                </div>
                <div>
                  <p class="text-xs text-slate-400 uppercase font-mono">Email Me</p>
                  <p class="text-sm font-medium">ashutosh2013official@gmail.com</p>
                </div>
              </a>

              <div class="flex items-center gap-4 group">
                <div class="w-12 h-12 bg-slate-800 rounded-2xl flex items-center justify-center group-hover:bg-sky-500 transition-colors">
                  📞
                </div>
                <div>
                  <p class="text-xs text-slate-400 uppercase font-mono">Call Me</p>
                  <p class="text-sm font-medium">+91 8168092721</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-slate-800 rounded-2xl flex items-center justify-center">
                   📍
                </div>
                <div>
                  <p class="text-xs text-slate-400 uppercase font-mono">Location</p>
                  <p class="text-sm font-medium">Haryana, India</p>
                </div>
              </div>
            </div>

            <div class="mt-10 pt-10 border-t border-slate-800 flex gap-4">
              <a href="https://github.com/ashutoshbibyan" class="p-3 bg-slate-800 rounded-xl hover:bg-sky-600 transition-all">Github</a>
            </div>
          </div>
        </div>

        <div class="col-span-12 lg:col-span-8">
          <div class="bg-white border border-slate-200 rounded-3xl p-8 md:p-12 shadow-sm">
            <form action="https://formspree.io/f/xvgbljnr" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="col-span-2 lg:col-span-1">
                <label class="block text-xs font-mono uppercase tracking-widest text-slate-500 mb-2">Your Name</label>
                <input type="text" name="name" required placeholder="John Doe"
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-sky-500 outline-none transition-all">
              </div>

              <div class="col-span-2 lg:col-span-1">
                <label class="block text-xs font-mono uppercase tracking-widest text-slate-500 mb-2">Email Address</label>
                <input type="email" name="email" required placeholder="john@example.com"
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-sky-500 outline-none transition-all">
              </div>

              <div class="col-span-2">
                <label class="block text-xs font-mono uppercase tracking-widest text-slate-500 mb-2">Subject</label>
                <input type="text" name="subject" placeholder="Project Inquiry"
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-sky-500 outline-none transition-all">
              </div>

              <div class="col-span-2">
                <label class="block text-xs font-mono uppercase tracking-widest text-slate-500 mb-2">Message</label>
                <textarea name="message" rows="5" required placeholder="Tell me about your project..."
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-sky-500 outline-none transition-all resize-none"></textarea>
              </div>

              <div class="col-span-2">
                <button type="submit"
                  class="w-full md:w-fit px-12 py-4 bg-slate-900 text-white font-bold rounded-xl hover:bg-sky-600 transition-all transform hover:-translate-y-1 active:scale-95 shadow-lg">
                  Send Message →
                </button>
              </div>
            </form>
          </div>
        </div>

      </div>
    </main>

  